---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { excerptText, stripHtml } from '../utils/site';

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const description = entry.data.seo?.description || excerptText(entry);
const title = entry.data.seo?.title || entry.data.title;
---

<BaseLayout
  title={title}
  description={description}
  path={entry.data.path}
  image={entry.data.featuredImage}
  type="article"
  schema={entry.data.seo?.schema}
>
  <article class="article-shell section">
    <header class="article-hero">
      <p class="eyebrow">Article</p>
      <h1>{entry.data.title}</h1>
      <p class="meta">
        {entry.data.date.toLocaleDateString('en-GB', { dateStyle: 'long' })}
        {entry.data.author && ` by ${entry.data.author}`}
      </p>
      {description && <p class="lede">{stripHtml(description)}</p>}
    </header>

    {entry.data.featuredImage && (
      <figure class="featured-media">
        <img src={entry.data.featuredImage} alt={entry.data.featuredImageAlt || entry.data.title} />
      </figure>
    )}

    <div class="content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article-shell {
    --hot: #ff3399;
    --ink: #090909;
    --muted: #5d554b;
    width: min(860px, calc(100% - 32px));
    margin: 0 auto;
  }

  .article-hero {
    padding-bottom: clamp(22px, 4vw, 34px);
    border-bottom: 5px solid var(--ink);
  }

  .eyebrow {
    display: inline-block;
    margin: 0 0 16px;
    padding: 6px 9px 4px;
    color: var(--ink);
    background: var(--hot);
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-size: clamp(2.55rem, 6.2vw, 5.2rem);
    font-weight: 900;
    line-height: 0.96;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .meta {
    margin: 18px 0 0;
    color: var(--muted);
    font-weight: 800;
  }

  .lede {
    max-width: 720px;
    margin: 22px 0 0;
    padding-left: 16px;
    color: var(--ink);
    border-left: 6px solid var(--hot);
    font-size: clamp(1.08rem, 2vw, 1.28rem);
    font-weight: 750;
    line-height: 1.5;
  }

  .featured-media {
    margin: clamp(24px, 4vw, 34px) 0;
    background: var(--ink);
    border: 4px solid var(--ink);
    box-shadow: 8px 8px 0 var(--hot);
    overflow: hidden;
  }

  .featured-media img {
    width: 100%;
    max-height: min(62vh, 620px);
    object-fit: cover;
  }

  .content {
    color: #27231f;
    font-size: 1.06rem;
  }

  .content :global(h2),
  .content :global(h3) {
    color: var(--ink);
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .content :global(h2) {
    margin-top: 2.4rem;
    font-size: clamp(1.8rem, 4.5vw, 3.1rem);
  }

  .content :global(h3) {
    margin-top: 2rem;
    font-size: clamp(1.45rem, 3vw, 2.15rem);
  }

  .content :global(img) {
    margin: 1.8rem auto;
    border: 3px solid var(--ink);
  }

  .content :global(blockquote) {
    padding: 18px 20px;
    color: var(--ink);
    background: #fff;
    border-left: 8px solid var(--hot);
  }

  @media (max-width: 620px) {
    .article-shell {
      width: min(100% - 28px, 860px);
      padding-top: 30px;
    }

    h1 {
      max-width: calc(100vw - 56px);
      font-size: clamp(1.02rem, 5vw, 1.24rem);
      line-height: 1;
    }

    .lede {
      max-width: calc(100vw - 56px);
      font-size: 0.94rem;
      line-height: 1.45;
    }

    .content :global(h2) {
      font-size: clamp(1.28rem, 6.8vw, 1.7rem);
    }

    .featured-media {
      box-shadow: 5px 5px 0 var(--hot);
    }

    .featured-media img {
      max-height: none;
    }

    .content {
      font-size: 1rem;
    }
  }
</style>
