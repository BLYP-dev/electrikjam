---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { excerptText } from '../utils/site';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const description = entry.data.seo?.description || excerptText(entry);
const title = entry.data.seo?.title || entry.data.title;
---

<BaseLayout
  title={title}
  description={description}
  path={entry.data.path}
  image={entry.data.featuredImage}
  schema={entry.data.seo?.schema}
>
  <article class="page-shell mx-auto w-full max-w-3xl px-4 py-10 md:px-6 md:py-14">
    <header class="page-hero">
      <p class="eyebrow">Page</p>
      <h1 class="page-title">{entry.data.title}</h1>
      {description && <p class="lede">{description}</p>}
    </header>
    {entry.data.featuredImage && (
      <figure class="featured-media">
        <img src={entry.data.featuredImage} alt={entry.data.featuredImageAlt || entry.data.title} />
      </figure>
    )}
    <div class="content break-words overflow-hidden">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page-shell {
    --hot: #ff3399;
    --ink: #090909;
    --muted: #5d554b;
  }

  .page-hero {
    padding-bottom: clamp(1.5rem, 4vw, 2rem);
    border-bottom: 5px solid var(--ink);
  }

  .eyebrow {
    display: inline-block;
    max-width: 100%;
    margin: 0 0 1rem;
    padding: 0.5rem 0.75rem 0.35rem;
    color: var(--ink);
    background: var(--hot);
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .page-title {
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-weight: 900;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .lede {
    max-width: 45rem;
    margin: 1.5rem 0 0;
    padding-left: 1rem;
    color: var(--ink);
    border-left: 6px solid var(--hot);
    font-size: clamp(1rem, 2vw, 1.18rem);
    font-weight: 750;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .featured-media {
    margin: clamp(1.5rem, 4vw, 2rem) 0;
    background: var(--ink);
    border: 4px solid var(--ink);
    box-shadow: 8px 8px 0 var(--hot);
    overflow: hidden;
  }

  .featured-media img {
    width: 100%;
    height: auto;
  }

  .content {
    color: #27231f;
    font-size: clamp(1rem, 1.6vw, 1.06rem);
  }

  .content :global(h2),
  .content :global(h3) {
    color: var(--ink);
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .content :global(h2) {
    margin-top: 2.4rem;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
  }

  .content :global(h3) {
    margin-top: 2rem;
    font-size: clamp(1.25rem, 2.4vw, 1.8rem);
  }

  .content :global(img) {
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto;
    border: 3px solid var(--ink);
  }

  @media (max-width: 620px) {
    .featured-media {
      box-shadow: 5px 5px 0 var(--hot);
    }

    .content {
      font-size: 1rem;
    }
  }
</style>
