---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { excerptText } from '../utils/site';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const description = entry.data.seo?.description || excerptText(entry);
const title = entry.data.seo?.title || entry.data.title;
---

<BaseLayout
  title={title}
  description={description}
  path={entry.data.path}
  image={entry.data.featuredImage}
  schema={entry.data.seo?.schema}
>
  <article class="narrow section">
    <p class="eyebrow">Page</p>
    <h1>{entry.data.title}</h1>
    {entry.data.featuredImage && (
      <img src={entry.data.featuredImage} alt={entry.data.featuredImageAlt || entry.data.title} />
    )}
    <div class="content">
      <slot />
    </div>
  </article>
</BaseLayout>
