---
import SEO from '../components/SEO.astro';
import { SITE_NAME } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  robots?: string;
  schema?: unknown;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO {...props} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${SITE_NAME} homepage`}>
        <img src="/assets/electrikjam-logo.webp" alt={SITE_NAME} width="1536" height="320" />
      </a>
      <nav aria-label="Primary">
        <a href="/category/gear/guitars/">Guitars</a>
        <a href="/category/gear/pedals/">Pedals</a>
        <a href="/category/amps/">Amps</a>
        <a href="/about-us/">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {SITE_NAME}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #fbfaf7;
    --ink: #181715;
    --muted: #615d56;
    --line: #ded9cf;
    --accent: #b41421;
    --accent-ink: #ffffff;
    --panel: #ffffff;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.65;
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .site-header,
  .site-footer {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    width: min(320px, 62vw);
    text-decoration: none;
  }

  .brand img {
    width: 100%;
    height: auto;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 16px;
    font-size: 0.94rem;
    font-weight: 700;
  }

  nav a {
    color: var(--ink);
    text-decoration: none;
  }

  main {
    min-height: 70vh;
  }

  .site-footer {
    padding: 32px 0 48px;
    color: var(--muted);
    border-top: 1px solid var(--line);
  }

  .container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .narrow {
    width: min(780px, calc(100% - 32px));
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    line-height: 1.12;
    letter-spacing: 0;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4.8rem);
  }

  .page-title,
  .title {
    margin: 0;
    font-size: clamp(1.8rem, 4.5vw, 3.1rem);
    line-height: 1;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  h2 {
    margin: 0 0 16px;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
  }

  .lede {
    max-width: 740px;
    color: var(--muted);
    font-size: 1.12rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }

  .card {
    display: grid;
    gap: 12px;
    min-height: 100%;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .card h3 {
    margin: 0;
    font-size: 1.22rem;
  }

  .card p {
    margin: 0;
    color: var(--muted);
  }

  .meta {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .content :where(p, ul, ol, blockquote) {
    margin: 0 0 1.2rem;
  }

  .content :where(h2, h3) {
    margin-top: 2rem;
  }

  .content table {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
  }

  .content th,
  .content td {
    padding: 10px;
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .hero {
    padding: clamp(48px, 8vw, 96px) 0;
  }

  .section {
    padding: 40px 0 64px;
  }

  @media (max-width: 680px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .page-title,
    .title {
      font-size: clamp(1.6rem, 8vw, 2.1rem);
    }

    nav {
      justify-content: flex-start;
    }
  }
</style>
