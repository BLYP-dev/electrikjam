---
import SEO from '../components/SEO.astro';
import { SITE_NAME } from '../utils/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  robots?: string;
  schema?: unknown;
}

const props = Astro.props;

const primaryNav = [
  { label: 'Best Guitar', href: '/best-electric-guitars/' },
  { label: 'News', href: '/category/news/' },
  { label: 'New Releases', href: '/new-guitar-releases/' },
  { label: 'Brands', href: '/category/gear/guitars/' },
  { label: 'Reviews', href: '/category/reviews/' },
  { label: 'Tutorials', href: '/category/tutorials/' },
  { label: 'Podcast', href: '/electrikjam-podcast/' },
];

const footerGroups = [
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about-us/' },
      { label: 'The Team', href: '/team-members/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Privacy Policy', href: '/privacy-policy/' },
      { label: 'Sitemap', href: '/sitemap-2/' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'The Podcast', href: '/electrikjam-podcast/' },
      { label: 'YouTube', href: 'https://www.youtube.com/channel/UChnXQNz2XmU_7zJmW1tqoTQ?app=desktop' },
      { label: 'The Mailing List', href: '/email-landing-page/' },
      { label: 'Work With Us', href: '/work-with-electrikjam/' },
    ],
  },
  {
    title: 'Gear We Rate',
    links: [
      { label: 'The Best Guitars', href: '/best-electric-guitars/' },
      { label: 'Top-Rated Pedals', href: '/category/gear/pedals/' },
      { label: 'Boss Katana Amps', href: '/tag/boss-katana/' },
      { label: 'Affordable Guitars', href: '/best-electric-guitars/best-budget-guitars/' },
      { label: 'Intermediate Guitars', href: '/best-electric-guitars/best-mid-range-electric-guitars/' },
    ],
  },
];

const socialLinks = [
  { label: 'Twitter', href: 'https://twitter.com/electrikjam1?lang=en-GB' },
  { label: 'Instagram', href: 'https://www.instagram.com/electrikjam/' },
  { label: 'Reddit', href: 'https://www.reddit.com/r/ELECTRIKJAM/' },
  { label: 'Facebook', href: 'https://www.facebook.com/electrikjamfans/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO {...props} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label={`${SITE_NAME} homepage`}>
          <img src="/assets/electrikjam-logo.webp" alt={SITE_NAME} width="1536" height="320" />
        </a>
        <nav class="primary-nav" aria-label="Primary">
          {primaryNav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
      <nav class="topic-nav" aria-label="Popular sections">
        <a href="/category/reviews/electric-guitars/">Electric Guitars</a>
        <a href="/category/reviews/guitar-amps/">Guitar Amps</a>
        <a href="/category/reviews/pedals-effects/">Pedals</a>
        <a href="/category/tutorials/guitar-tunings/">Tunings</a>
        <a href="/category/music-production/">Music Production</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-lead">
        <div>
          <p class="footer-kicker">Connect With {SITE_NAME}</p>
          <h2>Useful guitar advice, loud opinions, zero velvet rope.</h2>
        </div>
        <p>
          Gear reviews, setup guides, recording notes, and heavy-music recommendations for players
          who would rather plug in than scroll forever.
        </p>
      </div>
      <div class="footer-grid">
        <section class="footer-social" aria-labelledby="footer-social-title">
          <h3 id="footer-social-title">Social</h3>
          <p>If you want to reach out and connect with the ELECTRIKJAM team, this is where we hang out.</p>
          <div class="social-links">
            {socialLinks.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </section>
        {footerGroups.map((group) => (
          <section class="footer-links" aria-labelledby={`footer-${group.title.toLowerCase().replace(/\W+/g, '-')}`}>
            <h3 id={`footer-${group.title.toLowerCase().replace(/\W+/g, '-')}`}>{group.title}</h3>
            <ul>
              {group.links.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} NEW WORD ORDER LIMITED</p>
        <a href="/">ELECTRIKJAM</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #fbfaf7;
    --ink: #181715;
    --muted: #615d56;
    --line: #ded9cf;
    --accent: #b41421;
    --accent-ink: #ffffff;
    --panel: #ffffff;
    --display: Impact, Haettenschweiler, "Arial Black", sans-serif;
    --body: "Trebuchet MS", "Aptos", sans-serif;
    font-family: var(--body);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.65;
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .site-header {
    border-bottom: 4px solid var(--ink);
    background: var(--panel);
  }

  .site-header__inner,
  .topic-nav,
  .site-footer {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: minmax(12rem, 20rem) minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    padding: 1.2rem 0 0.95rem;
  }

  .brand {
    display: inline-flex;
    width: min(320px, 62vw);
    text-decoration: none;
  }

  .brand img {
    width: 100%;
    height: auto;
  }

  .primary-nav,
  .topic-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-weight: 700;
  }

  .primary-nav {
    justify-content: flex-end;
  }

  .primary-nav a,
  .topic-nav a {
    color: var(--ink);
    font-family: var(--display);
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .primary-nav a {
    padding: 0.55rem 0.7rem 0.48rem;
    border: 2px solid transparent;
    font-size: 0.96rem;
  }

  .primary-nav a:hover,
  .primary-nav a:focus-visible {
    border-color: var(--ink);
    background: #ff3399;
  }

  .topic-nav {
    padding: 0.7rem 0;
    border-top: 1px solid var(--line);
  }

  .topic-nav a {
    padding: 0.45rem 0.65rem 0.38rem;
    color: var(--muted);
    background: #f4efe5;
    border: 1px solid var(--line);
    font-size: 0.8rem;
  }

  .topic-nav a:hover,
  .topic-nav a:focus-visible {
    color: var(--accent-ink);
    background: var(--ink);
  }

  main {
    min-height: 70vh;
  }

  .site-footer {
    padding: clamp(2.5rem, 5vw, 4rem) 0 3rem;
    color: #f7f3eb;
    background: transparent;
  }

  body::after {
    content: "";
    display: block;
    height: 0;
  }

  .site-footer {
    width: 100%;
    max-width: none;
    margin-top: clamp(2rem, 5vw, 4rem);
    border-top: 6px solid #ff3399;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px) 0 0 / 22px 22px,
      #090909;
  }

  .footer-lead,
  .footer-grid,
  .footer-bottom {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .footer-lead {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: 2rem;
    border-bottom: 2px solid rgba(255, 255, 255, 0.16);
  }

  .footer-kicker {
    margin: 0 0 0.75rem;
    color: #ff3399;
    font-family: var(--display);
    font-size: 0.92rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer-lead h2,
  .footer-grid h3 {
    margin: 0;
    font-family: var(--display);
    line-height: 0.98;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .footer-lead h2 {
    max-width: 720px;
    font-size: clamp(2rem, 6vw, 4.2rem);
  }

  .footer-lead p:last-child,
  .footer-social p {
    margin: 0;
    color: #d4cec4;
    font-size: 1rem;
    font-weight: 700;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.25fr repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding: 2rem 0;
  }

  .footer-grid h3 {
    margin-bottom: 1rem;
    color: #fff;
    font-size: 1.2rem;
  }

  .footer-links ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-grid a,
  .footer-bottom a {
    color: #f7f3eb;
    font-weight: 900;
    text-decoration-color: #ff3399;
  }

  .footer-grid a:hover,
  .footer-bottom a:hover {
    color: #ff3399;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .social-links a {
    padding: 0.45rem 0.6rem;
    border: 2px solid rgba(255, 255, 255, 0.2);
    font-family: var(--display);
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 2px solid rgba(255, 255, 255, 0.16);
    color: #d4cec4;
    font-size: 0.92rem;
    font-weight: 800;
  }

  .footer-bottom p {
    margin: 0;
  }

  .container {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .narrow {
    width: min(780px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    line-height: 1.12;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
  }

  .page-title,
  .title {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
  }

  .lede {
    max-width: 740px;
    color: var(--muted);
    font-size: 1.12rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .card {
    display: grid;
    gap: 0.75rem;
    min-height: 100%;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .card h3 {
    margin: 0;
    font-size: 1.22rem;
  }

  .card p {
    margin: 0;
    color: var(--muted);
  }

  .meta {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .content :where(p, ul, ol, blockquote) {
    margin: 0 0 1.2rem;
  }

  .content :where(h2, h3) {
    margin-top: 2rem;
  }

  .content table {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
  }

  .content th,
  .content td {
    padding: 0.75rem;
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .hero {
    padding: clamp(3rem, 8vw, 6rem) 0;
  }

  .section {
    padding: 2.5rem 0 4rem;
  }

  @media (max-width: 680px) {
    .site-header__inner {
      grid-template-columns: 1fr;
    }

    .page-title,
    .title {
      font-size: clamp(1.5rem, 7vw, 2.1rem);
    }

    .primary-nav {
      justify-content: flex-start;
    }

    .footer-lead,
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
