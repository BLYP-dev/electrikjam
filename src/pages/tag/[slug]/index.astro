---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro';
import taxonomies from '../../../data/taxonomies.json';
import { archivePath, normalizePath, sortByDateDesc } from '../../../utils/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const archiveMap = new Map();

  for (const tag of taxonomies.tags || []) {
    archiveMap.set(tag.path, {
      slug: tag.slug,
      name: tag.name,
      path: tag.path,
      description: tag.seo?.description || tag.description || `Articles tagged ${tag.name}.`,
      seoTitle: tag.seo?.title || tag.name,
      entries: [],
    });
  }

  for (const post of posts) {
    post.data.tagSlugs.forEach((slug, index) => {
      const path = normalizePath(post.data.tagPaths[index] || archivePath('tag', slug));
      if (!archiveMap.has(path)) {
        archiveMap.set(path, {
          slug,
          name: post.data.tags[index] || slug,
          path,
          description: `Articles tagged ${post.data.tags[index] || slug}.`,
          seoTitle: post.data.tags[index] || slug,
          entries: [],
        });
      }
      archiveMap.get(path).entries.push(post);
    });
  }

  return Array.from(archiveMap.values()).map((archive) => ({
    params: { slug: archive.slug },
    props: archive,
  }));
}

const { name, path, description, seoTitle, entries } = Astro.props;
---

<ArchiveLayout
  title={name}
  seoTitle={seoTitle}
  description={description}
  path={path}
  entries={sortByDateDesc(entries)}
/>
