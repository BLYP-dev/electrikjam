---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page could not be found." path="/404/">
  <section class="narrow hero">
    <p class="eyebrow">404</p>
    <h1 class="page-title">Page not found.</h1>
    <p class="lede">This URL is not in the Astro migration build yet. During migration, missing URLs should be treated as parity issues until reviewed.</p>
    <p><a href="/">Return to the homepage</a></p>
  </section>
</BaseLayout>
