---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { excerptText, SITE_DESCRIPTION, sortByDateDesc } from '../utils/site';

const posts = sortByDateDesc(await getCollection('posts')).slice(0, 12);
const [leadPost, ...remainingPosts] = posts;
const secondaryPosts = remainingPosts.slice(0, 2);
const latestPosts = remainingPosts.slice(2);

const formatDate = (date: Date) => date.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});

const primaryCategory = (post: typeof posts[number]) => post.data.categories[0] || 'Gear';
---

<BaseLayout title="ELECTRIKJAM" description={SITE_DESCRIPTION} path="/">
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="container home-hero__inner">
        <p class="kicker">No Gloss. No Fluff. Loud Guitars Only.</p>
        <h1 id="home-title">Gear, noise, riffs, and the ugly truth about tone.</h1>
        <p class="home-standfirst">
          Reviews, guides, and opinionated dispatches for guitarists who like their gear useful,
          their amps angry, and their recommendations tested in the real world.
        </p>
      </div>
    </section>

    {leadPost && (
      <section class="container front-page" aria-label="Featured articles">
        <article class="lead-story">
          <a class="lead-story__image" href={leadPost.data.path} aria-label={leadPost.data.title}>
            {leadPost.data.featuredImage && (
              <img
                src={leadPost.data.featuredImage}
                alt={leadPost.data.featuredImageAlt || leadPost.data.title}
                loading="eager"
              />
            )}
          </a>
          <div class="lead-story__body">
            <p class="stamp">{primaryCategory(leadPost)} / {formatDate(leadPost.data.date)}</p>
            <h2><a href={leadPost.data.path}>{leadPost.data.title}</a></h2>
            <p>{excerptText(leadPost)}</p>
          </div>
        </article>

        <aside class="side-stack" aria-label="More top stories">
          <p class="rail-label">Latest</p>
          {secondaryPosts.map((post) => (
            <article class="side-story">
              <p class="stamp">{primaryCategory(post)}</p>
              <h3><a href={post.data.path}>{post.data.title}</a></h3>
              <p class="meta">{formatDate(post.data.date)}</p>
            </article>
          ))}
        </aside>
      </section>
    )}

    <section class="container issue-strip" aria-label="Editorial channels">
      <a href="/category/gear/guitars/">Guitars</a>
      <a href="/category/gear/pedals/">Pedals</a>
      <a href="/category/amps/">Amps</a>
      <a href="/category/music-production/">Recording</a>
      <a href="/category/music/">Records</a>
    </section>

    <section class="container latest-section">
      <div class="section-heading">
        <p class="rail-label">Fresh Copy</p>
        <h2>Latest Dispatches</h2>
      </div>
      {
        latestPosts.length > 0 ? (
          <div class="latest-grid">
            {latestPosts.map((post, index) => (
              <article class="latest-card">
                <p class="count">{String(index + 1).padStart(2, '0')}</p>
                {post.data.featuredImage && (
                  <a class="latest-card__image" href={post.data.path} aria-label={post.data.title}>
                    <img
                      src={post.data.featuredImage}
                      alt={post.data.featuredImageAlt || post.data.title}
                      loading="lazy"
                    />
                  </a>
                )}
                <div>
                  <p class="stamp">{primaryCategory(post)} / {formatDate(post.data.date)}</p>
                  <h3><a href={post.data.path}>{post.data.title}</a></h3>
                  <p>{excerptText(post)}</p>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="home-empty">Imported WordPress posts will appear here after the next content sync.</p>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  :global(body) {
    background: #f7f3eb;
  }

  :global(.site-header) {
    border-bottom: 4px solid #111;
  }

  :global(.site-header nav a) {
    color: #111;
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-size: 1.05rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  :global(.site-header nav a:hover) {
    color: #ff3399;
  }

  .home-page {
    --hot: #ff3399;
    --paper: #f7f3eb;
    --ink: #090909;
    --soft: #e7dfd0;
    --muted: #5d554b;
    color: var(--ink);
    background:
      linear-gradient(90deg, rgba(9, 9, 9, 0.035) 1px, transparent 1px) 0 0 / 18px 18px,
      var(--paper);
  }

  .home-hero {
    margin-top: 16px;
    background: var(--ink);
    color: #fff;
    border-block: 6px solid var(--hot);
  }

  .home-hero__inner {
    padding: clamp(26px, 4vw, 42px) 0 clamp(24px, 3.4vw, 36px);
  }

  .kicker,
  .stamp,
  .rail-label,
  .count {
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .kicker {
    display: inline-block;
    margin: 0 0 18px;
    padding: 7px 10px 5px;
    color: var(--ink);
    background: var(--hot);
    transform: rotate(-1deg);
  }

  .home-hero h1 {
    max-width: 1060px;
    margin: 0;
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-size: clamp(2.55rem, 7.15vw, 6.35rem);
    font-weight: 900;
    line-height: 0.93;
    text-transform: uppercase;
  }

  .home-standfirst {
    max-width: 720px;
    margin: 16px 0 0;
    color: #f3ece2;
    font-size: clamp(1rem, 1.55vw, 1.2rem);
    font-weight: 750;
  }

  .front-page {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(280px, 0.82fr);
    gap: 28px;
    padding: 34px 0 28px;
  }

  .lead-story,
  .side-stack,
  .latest-card {
    background: #fff;
    border: 4px solid var(--ink);
    box-shadow: 8px 8px 0 var(--hot);
  }

  .lead-story {
    display: grid;
    grid-template-columns: minmax(260px, 0.92fr) minmax(0, 1fr);
    min-height: 420px;
  }

  .lead-story__image {
    display: block;
    min-height: 100%;
    background: var(--ink);
    overflow: hidden;
  }

  .lead-story__image img {
    width: 100%;
    height: 100%;
    filter: grayscale(1) contrast(1.08);
    object-fit: cover;
    transition: filter 160ms ease, transform 160ms ease;
  }

  .lead-story:hover img,
  .latest-card:hover img {
    filter: grayscale(0) contrast(1.04);
    transform: scale(1.025);
  }

  .lead-story__body {
    display: flex;
    flex-direction: column;
    justify-content: end;
    padding: clamp(22px, 4vw, 36px);
    border-left: 4px solid var(--ink);
  }

  .stamp {
    margin: 0 0 12px;
    color: var(--hot);
    font-size: 0.84rem;
  }

  .lead-story h2,
  .side-story h3,
  .latest-card h3,
  .section-heading h2 {
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-weight: 900;
    text-transform: uppercase;
  }

  .lead-story h2 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 5rem);
    line-height: 0.95;
  }

  .lead-story p:last-child,
  .latest-card p:last-child {
    margin: 18px 0 0;
    color: var(--muted);
    font-weight: 650;
  }

  .home-page a {
    color: inherit;
    text-decoration-color: var(--hot);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.14em;
  }

  .home-page a:hover {
    color: var(--hot);
  }

  .side-stack {
    padding: 18px;
  }

  .rail-label {
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 4px solid var(--ink);
    color: var(--hot);
    font-size: 1rem;
  }

  .side-story {
    padding: 18px 0;
    border-bottom: 2px solid var(--ink);
  }

  .side-story:last-child {
    border-bottom: 0;
  }

  .side-story h3 {
    margin: 0;
    font-size: clamp(1.55rem, 3vw, 2.25rem);
    line-height: 0.98;
  }

  .meta {
    margin: 12px 0 0;
    color: var(--muted);
    font-weight: 800;
  }

  .issue-strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin-bottom: 30px;
    border: 4px solid var(--ink);
    background: var(--ink);
  }

  .issue-strip a {
    min-width: 0;
    padding: 12px 8px;
    color: #fff;
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-size: clamp(1rem, 2vw, 1.5rem);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    border-right: 2px solid #fff;
  }

  .issue-strip a:last-child {
    border-right: 0;
  }

  .issue-strip a:hover {
    color: var(--ink);
    background: var(--hot);
  }

  .latest-section {
    padding: 12px 0 72px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
    border-bottom: 6px solid var(--ink);
  }

  .section-heading .rail-label {
    margin-bottom: 10px;
    border-bottom: 0;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 5.6rem);
    line-height: 0.9;
  }

  .latest-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .latest-card {
    position: relative;
    display: flex;
    align-items: start;
    gap: 18px;
    min-height: 190px;
    padding: 14px;
    overflow: hidden;
  }

  .count {
    position: absolute;
    top: -18px;
    left: 12px;
    margin: 0;
    padding: 1px 8px 0;
    color: var(--ink);
    background: var(--hot);
    font-size: 1.35rem;
    line-height: 1.1;
  }

  .latest-card__image {
    display: block;
    flex: 0 0 clamp(132px, 32%, 180px);
    width: clamp(132px, 32%, 180px);
    max-width: 180px;
    min-width: 0;
    aspect-ratio: 1;
    background: var(--ink);
    border: 3px solid var(--ink);
    overflow: hidden;
  }

  .latest-card__image img {
    width: 100%;
    height: 100%;
    filter: grayscale(1) contrast(1.08);
    object-fit: cover;
    transition: filter 160ms ease, transform 160ms ease;
  }

  .latest-card h3 {
    margin: 0;
    font-size: clamp(1.22rem, 1.55vw, 1.72rem);
    line-height: 1.02;
    overflow-wrap: anywhere;
  }

  .latest-card p {
    margin: 0;
  }

  .latest-card > div {
    flex: 1 1 auto;
    min-width: 0;
  }

  .home-empty {
    padding: 24px;
    color: var(--ink);
    background: #fff;
    border: 4px solid var(--ink);
  }

  @media (max-width: 900px) {
    .front-page,
    .lead-story,
    .latest-grid {
      grid-template-columns: 1fr;
    }

    .lead-story__body {
      border-top: 4px solid var(--ink);
      border-left: 0;
    }

    .lead-story__image {
      aspect-ratio: 16 / 10;
    }

    .issue-strip {
      grid-template-columns: repeat(2, 1fr);
    }

    .issue-strip a {
      border-bottom: 2px solid #fff;
    }
  }

  @media (max-width: 620px) {
    :global(.site-header nav a) {
      font-size: 0.98rem;
    }

    .home-hero {
      margin-top: 16px;
      border-block-width: 6px;
    }

    .front-page {
      padding-top: 24px;
    }

    .lead-story,
    .side-stack,
    .latest-card {
      box-shadow: 5px 5px 0 var(--hot);
    }

    .latest-card {
      gap: 12px;
      padding: 12px;
    }

    .latest-card__image {
      flex-basis: 104px;
      width: 104px;
      max-width: 104px;
    }

    .latest-card p:last-child {
      display: none;
    }

    .section-heading {
      display: block;
    }
  }
</style>
