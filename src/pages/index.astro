---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { excerptText, SITE_DESCRIPTION, sortByDateDesc } from '../utils/site';

const posts = sortByDateDesc(await getCollection('posts')).slice(0, 12);
const [leadPost, ...remainingPosts] = posts;
const secondaryPosts = remainingPosts.slice(0, 2);
const latestPosts = remainingPosts.slice(2);

const formatDate = (date: Date) => date.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});

const primaryCategory = (post: typeof posts[number]) => post.data.categories[0] || 'Gear';
---

<BaseLayout title="ELECTRIKJAM" description={SITE_DESCRIPTION} path="/">
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="container home-hero__inner">
        <p class="kicker">No Gloss. No Fluff. Loud Guitars Only.</p>
        <h1 id="home-title">
          <span>Gear, noise, riffs,</span>
          <span>and the ugly truth</span>
          <span>about tone.</span>
        </h1>
        <p class="home-standfirst">
          Reviews, guides, and opinionated dispatches for guitarists who like their gear useful,
          their amps angry, and their recommendations tested in the real world.
        </p>
      </div>
    </section>

    {leadPost && (
      <section class="container front-page" aria-label="Featured articles">
        <article class="lead-story">
          <a class="lead-story__image" href={leadPost.data.path} aria-label={leadPost.data.title}>
            {leadPost.data.featuredImage && (
              <img
                src={leadPost.data.featuredImage}
                alt={leadPost.data.featuredImageAlt || leadPost.data.title}
                loading="eager"
              />
            )}
          </a>
          <div class="lead-story__body">
            <p class="stamp">{primaryCategory(leadPost)} / {formatDate(leadPost.data.date)}</p>
            <h2><a href={leadPost.data.path}>{leadPost.data.title}</a></h2>
            <p>{excerptText(leadPost)}</p>
          </div>
        </article>

        <aside class="side-stack" aria-label="More top stories">
          <p class="rail-label">Latest</p>
          {secondaryPosts.map((post) => (
            <article class="side-story">
              <p class="stamp">{primaryCategory(post)}</p>
              <h3><a href={post.data.path}>{post.data.title}</a></h3>
              <p class="meta">{formatDate(post.data.date)}</p>
            </article>
          ))}
        </aside>
      </section>
    )}

    <section class="container issue-strip" aria-label="Editorial channels">
      <a href="/category/gear/guitars/">Guitars</a>
      <a href="/category/gear/pedals/">Pedals</a>
      <a href="/category/amps/">Amps</a>
      <a href="/category/music-production/">Recording</a>
      <a href="/category/music/">Records</a>
    </section>

    <section class="container latest-section">
      <div class="section-heading">
        <p class="rail-label">Fresh Copy</p>
        <h2>Latest Dispatches</h2>
      </div>
      {
        latestPosts.length > 0 ? (
          <div class="latest-grid">
            {latestPosts.map((post, index) => (
              <article class="latest-card">
                <p class="count">{String(index + 1).padStart(2, '0')}</p>
                {post.data.featuredImage && (
                  <a class="latest-card__image" href={post.data.path} aria-label={post.data.title}>
                    <img
                      src={post.data.featuredImage}
                      alt={post.data.featuredImageAlt || post.data.title}
                      loading="lazy"
                    />
                  </a>
                )}
                <div>
                  <p class="stamp">{primaryCategory(post)} / {formatDate(post.data.date)}</p>
                  <h3><a href={post.data.path}>{post.data.title}</a></h3>
                  <p>{excerptText(post)}</p>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="home-empty">Imported WordPress posts will appear here after the next content sync.</p>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  :global(body) {
    background: #f7f3eb;
  }

  :global(.site-header) {
    border-bottom: 4px solid #111;
  }

  :global(.site-header nav a) {
    color: #111;
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-size: 1.05rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  :global(.site-header nav a:hover) {
    color: #ff3399;
  }

  .home-page {
    --hot: #ff3399;
    --paper: #f7f3eb;
    --ink: #090909;
    --soft: #e7dfd0;
    --muted: #5d554b;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;
    color: var(--ink);
    background:
      linear-gradient(90deg, rgba(9, 9, 9, 0.035) 1px, transparent 1px) 0 0 / 18px 18px,
      var(--paper);
    overflow-x: clip;
  }

  .home-hero {
    margin-top: var(--space-4);
    background: var(--ink);
    color: #fff;
    border-block: 6px solid var(--hot);
  }

  .home-hero__inner {
    padding: var(--space-8) 0;
  }

  .kicker,
  .stamp,
  .rail-label,
  .count {
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .kicker {
    display: inline-block;
    max-width: 100%;
    margin: 0 0 var(--space-4);
    padding: var(--space-2) var(--space-3);
    color: var(--ink);
    background: var(--hot);
    transform: rotate(-1deg);
    overflow-wrap: anywhere;
  }

  .home-hero h1 {
    margin: 0;
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-size: clamp(2rem, 12vw, 3.25rem);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .home-hero h1 span {
    display: block;
  }

  .home-standfirst {
    max-width: 720px;
    margin: var(--space-4) 0 0;
    color: #f3ece2;
    font-size: clamp(1rem, 4vw, 1.125rem);
    font-weight: 750;
    overflow-wrap: anywhere;
  }

  .front-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding: var(--space-8) 0 var(--space-6);
  }

  .lead-story,
  .side-stack,
  .latest-card {
    background: #fff;
    border: 4px solid var(--ink);
    box-shadow: 8px 8px 0 var(--hot);
  }

  .lead-story {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 0;
    overflow: hidden;
  }

  .lead-story__image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--ink);
    overflow: hidden;
  }

  .lead-story__image img {
    width: 100%;
    height: 100%;
    filter: grayscale(1) contrast(1.08);
    object-fit: cover;
    object-position: 34% center;
    transition: filter 160ms ease, transform 160ms ease;
  }

  .lead-story:hover img,
  .latest-card:hover img {
    filter: grayscale(0) contrast(1.04);
    transform: scale(1.025);
  }

  .lead-story__body {
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-6);
    border-top: 4px solid var(--ink);
  }

  .stamp {
    margin: 0 0 var(--space-3);
    color: var(--hot);
    font-size: 0.84rem;
    overflow-wrap: anywhere;
  }

  .lead-story h2,
  .side-story h3,
  .latest-card h3,
  .section-heading h2 {
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-weight: 900;
    text-transform: uppercase;
  }

  .lead-story h2 {
    margin: 0;
    font-size: clamp(1.55rem, 8vw, 2.15rem);
    line-height: 1;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .lead-story p:last-child,
  .latest-card p:last-child {
    margin: var(--space-4) 0 0;
    color: var(--muted);
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .home-page a {
    color: inherit;
    text-decoration-color: var(--hot);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.14em;
  }

  .home-page a:hover {
    color: var(--hot);
  }

  .side-stack {
    display: block;
    padding: var(--space-4);
    overflow: hidden;
  }

  .rail-label {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 4px solid var(--ink);
    color: var(--hot);
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  .side-story {
    padding: var(--space-4) 0;
    border-bottom: 2px solid var(--ink);
  }

  .side-story:last-child {
    border-bottom: 0;
  }

  .side-story h3 {
    margin: 0;
    font-size: clamp(1.35rem, 6vw, 1.8rem);
    line-height: 1;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .meta {
    margin: var(--space-3) 0 0;
    color: var(--muted);
    font-weight: 800;
  }

  .issue-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: var(--space-8);
    border: 4px solid var(--ink);
    background: var(--ink);
    overflow: hidden;
  }

  .issue-strip a {
    min-width: 0;
    padding: var(--space-3) var(--space-2);
    color: #fff;
    font-family: Impact, Haettenschweiler, "Arial Black", sans-serif;
    font-size: clamp(1rem, 2vw, 1.5rem);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    border-right: 2px solid #fff;
    border-bottom: 2px solid #fff;
    overflow-wrap: anywhere;
  }

  .issue-strip a:nth-child(2n),
  .issue-strip a:last-child {
    border-right: 0;
  }

  .issue-strip a:hover {
    color: var(--ink);
    background: var(--hot);
  }

  .latest-section {
    padding: var(--space-4) 0 var(--space-16);
  }

  .section-heading {
    display: block;
    margin-bottom: var(--space-6);
    border-bottom: 6px solid var(--ink);
    overflow: hidden;
  }

  .section-heading .rail-label {
    margin-bottom: var(--space-2);
    border-bottom: 0;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2.35rem, 12vw, 3.4rem);
    line-height: 1;
    overflow-wrap: break-word;
  }

  .latest-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    padding-top: var(--space-4);
  }

  .latest-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-6) var(--space-4) var(--space-4);
    overflow: hidden;
  }

  .count {
    position: absolute;
    top: 0;
    left: var(--space-4);
    margin: 0;
    padding: 0 var(--space-2);
    color: var(--ink);
    background: var(--hot);
    font-size: 1.35rem;
    line-height: 1.1;
  }

  .latest-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--ink);
    border: 3px solid var(--ink);
    overflow: hidden;
  }

  .latest-card__image img {
    width: 100%;
    height: 100%;
    filter: grayscale(1) contrast(1.08);
    object-fit: cover;
    transition: filter 160ms ease, transform 160ms ease;
  }

  .latest-card h3 {
    margin: 0;
    font-size: clamp(1.38rem, 7vw, 1.9rem);
    line-height: 1;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .latest-card p {
    margin: 0;
  }

  .latest-card > div {
    min-width: 0;
  }

  .home-empty {
    padding: var(--space-6);
    color: var(--ink);
    background: #fff;
    border: 4px solid var(--ink);
  }

  @media (min-width: 700px) {
    .side-stack {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }

    .side-stack .rail-label {
      grid-column: 1 / -1;
      margin-bottom: 0;
    }

    .issue-strip {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .issue-strip a {
      border-bottom: 0;
    }

    .issue-strip a:nth-child(2n) {
      border-right: 2px solid #fff;
    }

    .issue-strip a:last-child {
      border-right: 0;
    }
  }

  @media (min-width: 900px) {
    .home-hero__inner {
      padding: var(--space-10) 0;
    }

    .home-hero h1 {
      font-size: clamp(3.5rem, 7vw, 6.35rem);
      line-height: 0.93;
    }

    .home-standfirst {
      font-size: clamp(1rem, 1.55vw, 1.2rem);
    }

    .lead-story {
      grid-template-columns: minmax(0, 0.45fr) minmax(0, 0.55fr);
    }

    .lead-story__body {
      padding: var(--space-8);
      border-top: 0;
      border-left: 4px solid var(--ink);
    }

    .lead-story__image {
      aspect-ratio: 1 / 1;
    }

    .lead-story h2 {
      font-size: clamp(1.85rem, 2.55vw, 2.8rem);
      line-height: 0.97;
    }

    .latest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
      row-gap: var(--space-8);
    }

    .latest-card {
      grid-template-columns: minmax(8rem, 32%) minmax(0, 1fr);
      align-items: start;
      gap: var(--space-5);
      padding: var(--space-5);
    }

    .latest-card__image {
      aspect-ratio: 1;
    }

    .latest-card h3 {
      font-size: clamp(1.22rem, 1.55vw, 1.72rem);
      line-height: 1.02;
    }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: var(--space-5);
    }
  }

  @media (min-width: 1180px) {
    .front-page {
      grid-template-columns: minmax(0, 1fr) minmax(18.75rem, 0.32fr);
    }

    .side-stack {
      display: block;
    }

    .side-stack .rail-label {
      margin-bottom: var(--space-4);
    }
  }
</style>
